# Focus Sessions - Environment Configuration Template
# Copy this file to '.env' and fill in your real service credentials to enable live Email & SMS sending.

# Server Port
PORT=8000

# ==============================================================================
# Option 1: Standard SMTP Email Settings (Gmail, Outlook, Custom SMTP)
# ==============================================================================
# For Gmail: Use 'smtp.gmail.com', port 587, your email, and an App Password
# (Generate App Password at: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=hello@focussessions.com

# ==============================================================================
# Option 2: Resend Transactional Email API (https://resend.com)
# ==============================================================================
RESEND_API_KEY=re_123456789_abcdef
RESEND_FROM=onboarding@resend.dev

# ==============================================================================
# Option 3: Twilio SMS Text Delivery (https://twilio.com)
# ==============================================================================
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15550001122

# ==============================================================================
# Option 4: EmailJS Client Key (Optional)
# ==============================================================================
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
